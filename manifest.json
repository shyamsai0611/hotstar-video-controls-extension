{
  "manifest_version": 3,
  "name": "Hotstar Keyboard Controls",
  "version": "1.0",
  "description": "Enable keyboard controls on Hotstar videos",
  "content_scripts": [
    {
      "matches": [
        "*://*.hotstar.com/*",
        "*://*.jiohotstar.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}